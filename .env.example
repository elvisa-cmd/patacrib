# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it is in .gitignore.

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Any long random string, e.g.: openssl rand -base64 32
NEXTAUTH_SECRET=

# The public URL of your app (no trailing slash)
NEXTAUTH_URL=http://localhost:3000

# ─── Supabase PostgreSQL ─────────────────────────────────────────────────────
# Supabase Dashboard → Settings → Database → Connection string (URI mode)
# Use the "Session mode" pooler URL on port 5432 for Prisma compatibility.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ─── Supabase JS Client ──────────────────────────────────────────────────────
# Supabase Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co

# Supabase Dashboard → Settings → API → anon/public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Dashboard → Settings → API → service_role key
# WARNING: This key bypasses Row Level Security. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=

